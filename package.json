{
  "name": "environment-links-extension",
  "private": true,
  "version": "1.6.0",
  "description": "Chrome extension that opens the same link in every environment from the address bar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xontab/environment-links.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "zip -r environment-links.zip manifest.json src icons -x '*.DS_Store'",
    "keyword": "node scripts/set-keyword.js",
    "crx": "scripts/pack-crx.sh",
    "bump": "node scripts/bump-version.js"
  }
}
