{
  "manifest_version": 3,
  "name": "Environment Links",
  "version": "1.1",
  "description": "Jump from the address bar to the same link across every environment.",
  "omnibox": {
    "keyword": "e"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Environment Links",
    "default_popup": "src/popup.html"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://api.github.com/*"
  ]
}
