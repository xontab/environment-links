{
  "manifest_version": 3,
  "name": "Environment Links",
  "version": "1.7.1",
  "description": "Jump from the address bar to the same link across every environment.",
  "homepage_url": "https://github.com/xontab/environment-links",
  "omnibox": {
    "keyword": "e"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Environment Links",
    "default_popup": "src/popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open the link list"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "tabGroups"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "optional_host_permissions": [
    "https://api.github.com/*"
  ]
}
